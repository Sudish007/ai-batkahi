{
  "name": "ai-batkahi",
  "version": "1.0.0",
  "private": true,
  "description": "AI Batkahi — AI, machine learning and data science explained in Bhojpuri. Static blog for @batkahi.",
  "type": "module",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "build": "node src/build.js",
    "test": "node src/build.js && node --test \"tests/**/*.test.js\"",
    "serve": "node scripts/serve.mjs",
    "dryrun": "node scripts/dry-run-publish.mjs",
    "audit": "node scripts/audit.mjs",
    "check-links": "node scripts/check-external-links.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/tiro-devanagari-hindi": "5.3.0",
    "marked": "18.1.0"
  },
  "devDependencies": {
    "fast-xml-parser": "5.11.2"
  }
}
